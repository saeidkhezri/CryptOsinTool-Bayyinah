<?xml version="1.0" encoding="utf-8"?>
<!-- Bayyinah Forensic Suite - Data Extraction Rules for Android 12+ -->
<!-- Disallow cloud backup and device transfer of sensitive forensic evidence, keys, and dossiers -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
